# Copy to .env.local and fill in. Never commit the filled-in file.

# U.S. Census Data API key. Free, instant signup:
#   https://api.census.gov/data/key_signup.html
# Used server-side only for ACS 5-year demographics.
# The app runs without it; the demographics panel simply reports itself
# unavailable rather than failing the page.
CENSUS_API_KEY=your_census_api_key_here
